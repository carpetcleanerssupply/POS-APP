generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserTier {
  OWNER_MANAGER
  STAFF
}

enum InvoiceStatus {
  DRAFT
  CLOSED
}

enum SaleType {
  WALKIN
  PHONE
}

enum PaymentMethod {
  CARD
  CHECK
  CASH
  ACCOUNT
  CREDIT
}

enum SettledTo {
  PAID_NOW
  ACCOUNT
}

enum EstimateStatus {
  OPEN
  CONVERTED
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  tier         UserTier
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  invoicesAsEmployee Invoice[]       @relation("InvoiceEmployee")
  invoicesCreated    Invoice[]       @relation("InvoiceCreatedBy")
  paymentsRecorded   Payment[]       @relation("PaymentRecordedBy")
  paymentsVoided     Payment[]       @relation("PaymentVoidedBy")
  returnsProcessed   Return[]        @relation("ReturnProcessedBy")
  returnsVoided      Return[]        @relation("ReturnVoidedBy")
  purchaseOrders     PurchaseOrder[] @relation("PORecordedBy")
  estimatesCreated   Estimate[]      @relation("EstimateCreatedBy")
  activityLogs       ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id           String  @id @default(cuid())
  company      String?
  firstName    String?
  lastName     String?
  workPhone    String?
  cellPhone    String?
  email        String?
  email2       String?
  unsubscribed Boolean @default(false)
  webCustomer  Boolean @default(false)

  billingStreet  String?
  billingStreet2 String?
  billingCity    String?
  billingState   String?
  billingZip     String?

  shippingStreet    String?
  shippingStreet2   String?
  shippingCity      String?
  shippingState     String?
  shippingZip       String?
  shipSameAsBilling Boolean @default(true)

  balance    Decimal @default(0) @db.Decimal(12, 2)
  taxExempt  Boolean @default(false)
  resaleCert String?
  isWalkIn   Boolean @default(false)

  invoices  Invoice[]
  payments  Payment[]
  returns   Return[]
  estimates Estimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
  @@index([lastName, firstName])
}

model Item {
  id                String  @id @default(cuid())
  sku               String  @unique
  name              String
  category          String?
  vendorName        String?
  cost              Decimal @default(0) @db.Decimal(12, 2)
  price             Decimal @default(0) @db.Decimal(12, 2)
  stock             Int     @default(0)
  unit              String?
  caseQty           Int     @default(1)
  cogsAccount       String  @default("Cost of Goods Sold")
  incomeAccount     String  @default("Uncategorized")
  lowStockThreshold Int?

  invoiceLines  InvoiceLine[]
  returnLines   ReturnLine[]
  poLines       PurchaseOrderLine[]
  estimateLines EstimateLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([vendorName])
}

model Vendor {
  id          String  @id @default(cuid())
  name        String  @unique
  contactName String?
  phone       String?
  email       String?
  email2      String?

  addressStreet  String?
  addressStreet2 String?
  addressCity    String?
  addressState   String?
  addressZip     String?
  notes          String?

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id     String        @id @default(cuid())
  number Int           @unique @default(autoincrement())
  status InvoiceStatus @default(DRAFT)

  date       DateTime  @default(now())
  dueDate    DateTime?
  customerPO String?

  employeeId String?
  employee   User?   @relation("InvoiceEmployee", fields: [employeeId], references: [id])

  createdByUserId String
  createdBy       User   @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])

  saleType SaleType @default(WALKIN)

  customerId               String
  customer                 Customer @relation(fields: [customerId], references: [id])
  customerName             String
  customerEmail            String?
  customerEmail2           String?
  customerBillingSnapshot  Json?
  customerShippingSnapshot Json?

  shipVia        String?
  trackingNumber String?

  convertedFromEstimateId String?   @unique
  convertedFromEstimate   Estimate? @relation(fields: [convertedFromEstimateId], references: [id])

  notes String?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  shippingCharge Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  paymentMethod PaymentMethod?
  checkNumber   String?
  settledTo     SettledTo?
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)

  lines               InvoiceLine[]
  paymentApplications PaymentApplication[]
  returns             Return[]

  emailHistory DateTime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([date])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?   @relation(fields: [itemId], references: [id])
  sku         String
  name        String
  qty         Int
  price       Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  ext         Decimal @db.Decimal(12, 2)
  note        String?
  lineOrder   Int     @default(0)

  @@index([invoiceId])
  @@index([itemId])
}

model Payment {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String

  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  checkNumber String?

  unapplied         Decimal @default(0) @db.Decimal(12, 2)
  creditSourceLabel String?

  atSale Boolean @default(false)

  recordedByUserId String
  recordedBy       User   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  voided         Boolean   @default(false)
  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?     @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id])

  applications PaymentApplication[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([voided])
}

model PaymentApplication {
  id            String  @id @default(cuid())
  paymentId     String
  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  amountApplied Decimal @db.Decimal(12, 2)

  @@index([paymentId])
  @@index([invoiceId])
}

model Return {
  id     String   @id @default(cuid())
  number Int      @unique @default(autoincrement())
  date   DateTime @default(now())

  originalInvoiceId String
  originalInvoice   Invoice  @relation(fields: [originalInvoiceId], references: [id])
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  customerName      String

  total        Decimal       @db.Decimal(12, 2)
  refundMethod PaymentMethod
  checkNumber  String?
  reason       String?

  processedByUserId String
  processedBy       User   @relation("ReturnProcessedBy", fields: [processedByUserId], references: [id])

  voided         Boolean   @default(false)
  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?     @relation("ReturnVoidedBy", fields: [voidedByUserId], references: [id])

  lines ReturnLine[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([originalInvoiceId])
}

model ReturnLine {
  id       String  @id @default(cuid())
  returnId String
  return   Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId   String?
  item     Item?   @relation(fields: [itemId], references: [id])
  sku      String
  name     String
  qty      Int
  price    Decimal @db.Decimal(12, 2)
  ext      Decimal @db.Decimal(12, 2)

  @@index([returnId])
}

model Estimate {
  id             String    @id @default(cuid())
  number         Int       @unique @default(autoincrement())
  date           DateTime  @default(now())
  expirationDate DateTime?

  customerId               String
  customer                 Customer @relation(fields: [customerId], references: [id])
  customerName             String
  customerEmail            String?
  customerEmail2           String?
  customerBillingSnapshot  Json?
  customerShippingSnapshot Json?

  lines EstimateLine[]

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  shippingCharge Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  notes          String?

  status EstimateStatus @default(OPEN)

  createdByUserId String
  createdBy       User   @relation("EstimateCreatedBy", fields: [createdByUserId], references: [id])

  convertedInvoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?    @relation(fields: [itemId], references: [id])
  sku         String
  name        String
  qty         Int
  price       Decimal  @db.Decimal(12, 2)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  ext         Decimal  @db.Decimal(12, 2)
  note        String?

  @@index([estimateId])
}

model PurchaseOrder {
  id           String     @id @default(cuid())
  number       Int        @unique @default(autoincrement())
  vendorName   String
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  date         DateTime   @default(now())
  status       POStatus   @default(DRAFT)
  notes        String?
  paid         Boolean    @default(false)
  checkNumber  String?
  emailHistory DateTime[]

  recordedByUserId String
  recordedBy       User   @relation("PORecordedBy", fields: [recordedByUserId], references: [id])

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?         @relation(fields: [itemId], references: [id])
  sku         String
  name        String
  description String?
  qtyOrdered  Int
  qtyReceived Int           @default(0)
  cost        Decimal       @db.Decimal(12, 2)
  caseQty     Int           @default(1)

  @@index([poId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    Json?

  @@index([timestamp])
  @@index([entityType, entityId])
}
